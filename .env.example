# docme/.env  (admin/CLI tooling — for seeding data, impersonation, etc.)
# ⚠️ NEVER COMMIT. The .gitignore excludes .env (see !.env.example).

# Base URL of the Blocks API
BLOCKS_API_URL=https://api.seliseblocks.com

# Your portal login credentials — these run against /iam/v4/auth-login
BLOCKS_USERNAME=you@example.com
BLOCKS_PASSWORD=replace-with-your-password
