# docme/.env.local  (frontend — Vite-prefixed only, public values)
# ⚠️ NEVER COMMIT. The .gitignore excludes .env.local (see !.env.local.example).

# IMPORTANT: use the blocksapi host for *.slsblx.com domains, NOT api.seliseblocks.com,
# so the SSO session cookie stays same-site with the app.
VITE_BLOCKS_API_URL=https://blocksapi.slsblx.com

# Your project tenant id (the value you have as x-blocks-key).
VITE_BLOCKS_PROJECT_KEY=replace-with-project-tenant-id

# From the OIDC client you configured for this project.
VITE_BLOCKS_OIDC_CLIENT_ID=replace-with-oidc-client-id

# Must be one of the redirectUris registered on the OIDC client.
# Port 5173 is included for local dev; in production it should be the port-less URL.
VITE_BLOCKS_REDIRECT_URI=https://dmqhre.slsblx.com:5173/callback

# Local HTTPS dev server (matches vite.config.ts).
VITE_DEV_DOMAIN=dmqhre.slsblx.com
VITE_DEV_PORT=5173
